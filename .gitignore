# Android / Gradle
*.iml
.gradle/
local.properties
.idea/
.DS_Store
# Android build output only. NOT "build/": that pattern also matches desktop/build/, which
# holds the Windows icon files that must be committed (electron-builder said "default
# Electron icon is used" because they were ignored).
/app/build/
/build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex
*.class
bin/
gen/
out/
release/

# Signing secrets — never commit these
keystore.properties
# The one signing key shared by the PC and the phone (tools/publish.ps1 and
# termux-build.sh both write it). Never committed, and never delete it: losing it means
# every installed copy has to be uninstalled once.
agon-build.jks
agon-build.properties
# A copy of that key for the phone to pick up. Same rules: never committed.
AGON-KEY.md
gh-token.txt
*.jks
*.keystore

# Python tooling
__pycache__/
*.pyc

# Local version baseline (generated by commit.bat / publish.bat)
version.txt

# Desktop client (Electron): dependencies, build output and the generated lockfile
desktop/node_modules/
desktop/release/
desktop/out/
# desktop/build/icon.ico + icon.png are committed on purpose: the Windows build must not
# need Python or Pillow just to package an icon. Regenerate with: npm run icon

# generated by artwork/make-icons.py (it writes into ../ from the artwork folder)
artwork/mark.png
artwork/app-icon-preview.png
artwork/app/

# Frame dumps extracted from screen recordings (evidence, not source)
google_drive/
frames/
