<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background: the mark's own charcoal, with a barely-there warm-to-cool
     gradient so the tile does not look like a flat swatch next to Android's own icons.
     Painted edge to edge on purpose: launchers crop the 108dp canvas down to the inner
     ~72dp, so anything that has to stay visible lives in the foreground layer. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#1C1C1C" />
                <item android:offset="0.55" android:color="#191919" />
                <item android:offset="1" android:color="#141414" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
