<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext stays off for the internet, which is what the manifest says everywhere else.

    The one exception is the phone itself: a development server on 127.0.0.1 / localhost /
    10.0.2.2 is plain http by design, and with `usesCleartextTraffic="false"` the WebView
    refuses it before a byte is sent. That is a click that does nothing. Loopback is not a
    downgrade - the request never leaves the device - so it is allowed here, by exact host,
    and nothing else is.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
