{
  "name": "agon-desktop",
  "productName": "Agon",
  "version": "1.4.22",
  "description": "Agon - an unofficial desktop client for arena.ai",
  "author": "Erawat4l",
  "license": "Apache-2.0",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "python ../artwork/make-icons.py",
    "dist": "electron-builder --publish never",
    "dist:dir": "electron-builder --dir",
    "release": "electron-builder --publish always",
    "dist:branded": "electron-builder -c.win.signAndEditExecutable=true"
  },
  "devDependencies": {
    "electron": "26.6.10",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "app.erawat.agon",
    "productName": "Agon",
    "copyright": "Copyright 2026 the Agon contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/icon-64.png",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../NOTICE.md",
        "to": "NOTICE.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Agon-Desktop-${version}-${arch}.${ext}",
      "publisherName": "Agon",
      "signAndEditExecutable": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Agon",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Agon-Setup-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Erawat4l",
        "repo": "Agon",
        "releaseType": "release"
      }
    ],
    "asar": true,
    "beforePack": "scripts/before-pack.js",
    "afterAllArtifactBuild": "scripts/make-release-assets.js"
  }
}
